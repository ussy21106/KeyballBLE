#define ZMK_POINTING_DEFAULT_SCRL_VAL 120    // default: 10

#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

#define MOUSE 4
#define SCROLL 5
#define NUM 6

&mt {
    flavor = "balanced";
    quick-tap-ms = <0>;
};

/ {
    combos {
        compatible = "zmk,combos";

        double_quotation {
            bindings = <&kp DOUBLE_QUOTES>;
            key-positions = <20 21>;
        };

        To_Layer1 {
            bindings = <&mo 1>;
            key-positions = <11 12>;
        };
    };

    macros {
        to_layer_0: to_layer_0 {
            compatible = "zmk,behavior-macro-one-param";
            #binding-cells = <1>;
            bindings = <&to 0 &macro_param_1to1 &kp MACRO_PLACEHOLDER>;
            label = "TO_LAYER_0";
        };

        Mac_screenshot: Mac_screenshot {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LS(LG(KP_NUMBER_5))>;
            label = "MAC_SCREENSHOT";
        };
    };

    behaviors {
        lt_to_layer_0: lt_to_layer_0 {
            compatible = "zmk,behavior-hold-tap";
            label = "LAYER_TAP_TO_0";
            bindings = <&mo>, <&to_layer_0>;

            #binding-cells = <2>;
            tapping-term-ms = <200>;
        };

        ROTATE: ROTATE {
            compatible = "zmk,behavior-sensor-rotate-var";
            label = "ROTATE";
            #sensor-binding-cells = <2>;
            bindings = <&msc>, <&msc>;

            tap-ms = <20>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            bindings = <
&kp Q             &kp W         &kp E         &kp R                   &kp T                                                           &kp Y        &kp U    &kp I      &kp O    &kp P
&kp A             &kp S         &kp D         &kp F                   &kp G        &mkp RCLK                   &kp BACKSLASH          &kp H        &lt 3 J  &kp K      &kp L    &lt 5 MINUS
&mt LEFT_SHIFT Z  &kp X         &kp C         &kp V                   &kp B        &mkp LCLK                   &kp AT_SIGN            &kp N        &kp M    &kp COMMA  &kp DOT  &mt RIGHT_SHIFT SLASH
&kp LCTRL         &kp LEFT_WIN  &kp LEFT_ALT  &lt_to_layer_0 6 LANG1  &lt 2 SPACE  &lt_to_layer_0 3 LANG2      &mt RIGHT_COMMAND TAB  &lt 1 ENTER                               &kp LS(LG(N5))
            >;

            sensor-bindings = <&ROTATE SCRL_DOWN SCRL_UP>;
        };

        ARROW {
            bindings = <
&kp ESCAPE  &none  &none  &none          &none                              &none     &kp HOME        &none         &kp END          &kp BACKSPACE
&kp TAB     &none  &none  &kp PAGE_UP    &kp BACKSPACE  &trans      &none   &kp LEFT  &kp DOWN_ARROW  &kp UP_ARROW  &kp RIGHT_ARROW  &kp LG(RIGHT_BRACKET)
&none       &none  &none  &kp PAGE_DOWN  &kp DELETE     &trans      &none   &none     &mkp LCLK       &none         &mkp RCLK        &kp LG(LEFT_BRACKET)
&none       &none  &none  &trans         &trans         &trans      &trans  &trans                                                   &kp RIGHT_SHIFT
            >;
        };

        NUM {
            bindings = <
&kp EXCLAMATION  &kp DOUBLE_QUOTES  &kp HASH         &kp DOLLAR       &kp PERCENT                          &kp AMPERSAND    &kp SQT          &kp LEFT_PARENTHESIS  &kp RIGHT_PARENTHESIS  &kp MINUS
&kp KP_NUMBER_1  &kp KP_NUMBER_2    &kp KP_NUMBER_3  &kp KP_NUMBER_4  &kp KP_NUMBER_5  &trans      &none   &kp KP_NUMBER_6  &kp KP_NUMBER_7  &kp KP_NUMBER_8       &kp KP_NUMBER_9        &kp KP_NUMBER_0
&kp LG(Z)        &kp LG(X)          &kp LG(C)        &kp LG(V)        &kp LG(Y)        &trans      &none   &none            &kp KP_EQUAL     &kp PLUS              &kp ASTRK              &kp UNDERSCORE
&kp LG(A)        &trans             &trans           &trans           &trans           &trans      &trans  &trans                                                                         &none
            >;
        };

        FUNCTION {
            bindings = <
&kp F1                  &kp F2                &kp F3                  &kp F4                   &kp F5                      &kp F6  &kp F7                &kp F8                 &kp F9         &kp F10
&kp LA(LG(DOWN_ARROW))  &kp LA(LG(UP_ARROW))  &kp LC(LEFT_ARROW)      &kp LC(RIGHT_ARROW)      &none   &trans      &trans  &none   &kp LEFT_BRACKET      &kp RIGHT_BRACKET      &kp SEMICOLON  &kp F11
&kp LEFT_SHIFT          &none                 &kp LA(LG(LEFT_ARROW))  &kp LA(LG(RIGHT_ARROW))  &none   &trans      &trans  &none   &kp LS(LEFT_BRACKET)  &kp LS(RIGHT_BRACKET)  &kp COLON      &kp F12
&kp LCTRL               &trans                &trans                  &trans                   &trans  &trans      &trans  &trans                                                              &trans
            >;

            sensor-bindings = <&inc_dec_kp LC(PAGE_UP) LC(PAGE_DOWN)>;
        };

        MOUSE {
            bindings = <
&trans    &trans     &trans     &trans     &trans                           &trans    &trans     &trans     &trans     &trans
&mkp MB4  &mkp LCLK  &mkp MCLK  &mkp RCLK  &mkp MB5  &mkp RCLK      &trans  &mkp MB4  &mkp LCLK  &mkp MCLK  &mkp RCLK  &mkp MB5
&trans    &trans     &trans     &trans     &trans    &mkp LCLK      &trans  &trans    &trans     &trans     &trans     &trans
&trans    &trans     &trans     &trans     &trans    &trans         &trans  &trans                                     &trans
            >;
        };

        SCROLL {
            bindings = <
&trans  &trans  &trans  &trans  &trans                      &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans                          &trans
            >;
        };

        layer_6 {
            bindings = <
&trans  &trans        &trans        &trans        &trans                                 &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4
&trans  &trans        &trans        &trans        &trans     &trans      &studio_unlock  &trans        &trans        &trans        &trans        &trans
&trans  &kp NUMBER_1  &kp NUMBER_2  &kp NUMBER_3  &kt KP_N4  &trans      &bootloader     &trans        &trans        &trans        &trans        &bt BT_CLR
&trans  &trans        &trans        &trans        &trans     &trans      &trans          &trans                                                  &bt BT_CLR_ALL
            >;
        };
    };
};
