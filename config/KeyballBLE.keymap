#define ZMK_POINTING_DEFAULT_SCRL_VAL 120    // default: 10

// レイヤー定義
// デフォルトレイヤー (接続先ごと)

#define DEFAULT_LAYER 0  // デスクトップMac用
#define DEFAULT_LAYER_MAC_NOTE 1     // ノートMac用
#define DEFAULT_LAYER_IPAD 2         // iPad用
#define DEFAULT_LAYER_WIN_DESKTOP 3  // デスクトップWin用
#define DEFAULT_LAYER_WIN_COMPANY 4  // 会社用Win用

// 機能レイヤー

#define LAYER_ARROW_MAC 5      // 矢印移動Macキーレイヤー
#define LAYER_ARROW_WIN 6      // 矢印移動Winキーレイヤー
#define LAYER_NUM 7   // 数字キーレイヤー
#define LAYER_FUNCTION 8   // ファンクションキーレイヤー
#define LAYER_SYMBOL 9     // 記号レイヤー
#define LAYER_10 10     // 記号レイヤー
#define LAYER_11 11     // 記号レイヤー
#define LAYER_12 12     // 記号レイヤー
#define LAYER_MOUSE 13      // マウス操作レイヤー
#define LAYER_SCROLL 14   // スクロールレイヤー
#define LAYER_SETTINGS 15  // 設定レイヤー

// 接続先ごとのデフォルトレイヤーを定義
#define BT_PROFILE_0 DEFAULT_LAYER  // 接続先1: デスクトップMac
#define BT_PROFILE_1 DEFAULT_LAYER_MAC_NOTE     // 接続先2: ノートMac
#define BT_PROFILE_2 DEFAULT_LAYER_IPAD         // 接続先3: iPad
#define BT_PROFILE_3 DEFAULT_LAYER_WIN_DESKTOP  // 接続先4: デスクトップWin
#define BT_PROFILE_4 DEFAULT_LAYER_WIN_COMPANY  // 接続先5: 会社用Win

#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/outputs.h>    //USB/BT切替設定のため
#include <dt-bindings/zmk/pointing.h>
#include <input/processors.dtsi>
//USコードをJISに変えるコード
#include "code.h"

// Autoshift Macro（記号利用、通常キーは影響が大きいため）
#define ASSYM(shifted, keycode) &auto_shift shifted keycode

//#define MOUSE 4
//#define SCROLL 5
//#define NUM 6

//AML関連設定
&zip_temp_layer {
    excluded-positions = <
        30 // M
        32 // .
        34 // LEFT_CONTROL
        13 // F
        18 // J
        //Macro対応のため不要 22 // LEFT_SHIFT
        //Macro対応のため不要 33 // RIGHT_SHIFT
        //Macro対応のため不要 41 // RIGHT_COMMAND
    >;
};

//キー入力から一定時間はAMLを発動しない
&zip_temp_layer {
    require-prior-idle-ms = <200>;
};
//マウスキーを押したらタイムアウトを延長する
&mkp_input_listener {
    input-processors = <&zip_temp_layer LAYER_MOUSE 10000>;
};
//マウスキーを押すまでマウスレイヤーに留まる(マウスキーを押したらタイムアウトを延長すると同じ実装で、タイムアウト時間が違うだけ)
&mkp_input_listener {
    input-processors = <&zip_temp_layer LAYER_MOUSE 250>;
};


&mt {
    flavor = "balanced";
    quick-tap-ms = <0>;
};

/ {
    combos {
        compatible = "zmk,combos";
        combo-term-ms = <30>;  // デフォルトは 50ms

        double_quotation {
            bindings = <&kp DOUBLE_QUOTES>;
            key-positions = <20 21>;
        };

//        To_LayerARROW {
//            bindings = <&mo LAYER_ARROW>;  // ARROWレイヤーに移動
//            key-positions = <11 12>;
//        };

        To_LayerSYMBOL {
            timeout-ms = <50>;
            bindings = <&togle_symbol>;  // SYMBOLレイヤーに移動して、英数キーを押す
            //key-positions = <23 24>;
            key-positions = <11 12>;
            layers = <0 1 2 3 4 LAYER_SYMBOL>;  // 全レイヤーで有効
        };

        To_LayerSETTING {
            bindings = <&mo LAYER_SETTINGS>;  // 設定レイヤーに移動
            //combo-term-ms = 30;
            key-positions = <38 37>;
        };

        chk_keynum1 {
            bindings = <&none>;
            key-positions = <0 10>;
        };

        chk_keynum2 {
            bindings = <&none>;
            key-positions = <9 21>;
        };

        chk_keynum3 {
            bindings = <&none>;
            key-positions = <22 34>;
        };

        chk_keynum4 {
            bindings = <&none>;
            key-positions = <41 42>;
        };
    };

    macros {

        // BTの全切断
        all_BT_Disc: all_BT_Disc {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&bt BT_DISC 1 &bt BT_DISC 2 &bt BT_DISC 3 &bt BT_DISC 4>;
            label = "all_BT_Disc";            
        };

        // 接続先切り替えマクロ
        switch_to_mac_desktop: switch_to_mac_desktop {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&all_BT_Disc &tog_off DEFAULT_LAYER_MAC_NOTE &tog_off DEFAULT_LAYER_IPAD &tog_off DEFAULT_LAYER_WIN_DESKTOP &tog_off DEFAULT_LAYER_WIN_COMPANY &bt BT_SEL 0 &tog_on DEFAULT_LAYER>;
            label = "SWITCH_TO_MAC_DESKTOP";
        };

        switch_to_mac_note: switch_to_mac_note {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&all_BT_Disc &tog_off DEFAULT_LAYER &tog_off DEFAULT_LAYER_IPAD &tog_off DEFAULT_LAYER_WIN_DESKTOP &tog_off DEFAULT_LAYER_WIN_COMPANY &bt BT_SEL 1 &tog_on DEFAULT_LAYER_MAC_NOTE>;
            label = "SWITCH_TO_MAC_NOTE";
        };

        switch_to_ipad: switch_to_ipad {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&all_BT_Disc &tog_off DEFAULT_LAYER &tog_off DEFAULT_LAYER_MAC_NOTE &tog_off DEFAULT_LAYER_WIN_DESKTOP &tog_off DEFAULT_LAYER_WIN_COMPANY &bt BT_SEL 2 &tog_on DEFAULT_LAYER_IPAD>;
            label = "SWITCH_TO_IPAD";
        };

        switch_to_win_desktop: switch_to_win_desktop {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&all_BT_Disc &tog_off DEFAULT_LAYER &tog_off DEFAULT_LAYER_MAC_NOTE &tog_off DEFAULT_LAYER_IPAD &tog_off DEFAULT_LAYER_WIN_COMPANY &bt BT_SEL 3 &tog_on DEFAULT_LAYER_WIN_DESKTOP>;
            label = "SWITCH_TO_WIN_DESKTOP";
        };

        switch_to_win_company: switch_to_win_company {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&all_BT_Disc &tog_off DEFAULT_LAYER &tog_off DEFAULT_LAYER_MAC_NOTE &tog_off DEFAULT_LAYER_IPAD &tog_off DEFAULT_LAYER_WIN_DESKTOP &bt BT_SEL 4 &tog_on DEFAULT_LAYER_WIN_COMPANY>;
            label = "SWITCH_TO_WIN_COMPANY";
        };

        to_default_layer: to_default_layer {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&to DEFAULT_LAYER &to DEFAULT_LAYER_MAC_NOTE &to DEFAULT_LAYER_IPAD &to DEFAULT_LAYER_WIN_DESKTOP &to DEFAULT_LAYER_WIN_COMPANY>;
            label = "TO_DEFAULT_LAYER";
        };

        to_layer_df: to_layer_df {
            compatible = "zmk,behavior-macro-one-param";
            #binding-cells = <1>;
            bindings = <&to &to_default_layer &macro_param_1to1 &kp MACRO_PLACEHOLDER>;
            label = "TO_LAYER_df";
        };

        Mac_screenshot: Mac_screenshot {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LG(LS(N5))>;
            label = "MAC_SCREENSHOT";
        };

        Win_screenshot: Win_screenshot {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LG(LS(S))>;
            label = "WIN_SCREENSHOT";
        };

        //AML関連設定
        exit_AML: exit_AML {
            compatible = "zmk,behavior-macro";
            wait-ms = <0>;
            tap-ms = <0>;
            #binding-cells = <0>;
            bindings = <&tog_off LAYER_MOUSE>;
            label = "exit_AML";
        };

        kp_exit_AML: kp_exit_AML {
            compatible = "zmk,behavior-macro-one-param";
            wait-ms = <0>;
            tap-ms = <0>;
            #binding-cells = <1>;
            bindings = <&macro_param_1to1 &kp MACRO_PLACEHOLDER &exit_AML>;
            label = "KP_exit_AML";
        };

        // 数字レイヤー移動 + 英数キー
        togle_num: togle_num {
            label = "TOGGLE_NUM";
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = 
                <&kp LANG2>,       // 英数キー
                <&tog LAYER_NUM>;  // 数字レイヤーに移動
        };

        // 記号レイヤー移動 + 英数キー
        togle_symbol: togle_symbol {
            label = "TOGGLE_SYMBOL";
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = 
                <&kp LANG2>,          // 英数キー
                <&tog LAYER_SYMBOL>;  // 記号レイヤーに移動
        };
    };

    behaviors {
        lt_to_layer_0: lt_to_layer_0 {
            compatible = "zmk,behavior-hold-tap";
            label = "LAYER_TAP_TO_0";
            bindings = <&mo>, <&to_layer_df>;

            #binding-cells = <2>;
            tapping-term-ms = <200>;
        };

        tog_on: toggle_layer_on_only {
            compatible = "zmk,behavior-toggle-layer";
            #binding-cells = <1>;
            display-name = "Toggle Layer On";
            toggle-mode = "on";
        };

        tog_off: toggle_layer_off_only {
            compatible = "zmk,behavior-toggle-layer";
            #binding-cells = <1>;
            display-name = "Toggle Layer Off";
            toggle-mode = "off";
        };

        ROTATE: ROTATE {
            compatible = "zmk,behavior-sensor-rotate-var";
            label = "ROTATE";
            #sensor-binding-cells = <2>;
            bindings = <&msc>, <&msc>;

            tap-ms = <20>;
        };

        scroll_up_down: behavior_sensor_rotate_mouse_wheel_up_down {
            compatible = "zmk,behavior-sensor-rotate";
            #sensor-binding-cells = <0>;
            bindings = <&msc SCRL_DOWN>, <&msc SCRL_UP>;

            //tap-ms = <20>;
        };

        scroll_encoder: scroll_encoder {
            compatible = "zmk,behavior-sensor-rotate";
            #sensor-binding-cells = <0>;
            bindings = <&scroll_down>, <&scroll_up>;
        };

        // 上スクロール（小刻みに複数回）
        scroll_up: scroll_up {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&msc SCRL_UP &msc SCRL_UP>;  // 2回送信で滑らか
        };

        // 下スクロール（小刻みに複数回）
        scroll_down: scroll_down {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&msc SCRL_DOWN &msc SCRL_DOWN>;  // 2回送信で滑らか
        };

        //AML
        mt_exit_AML_on_tap: mt_exit_AML_on_tap {
            compatible = "zmk,behavior-hold-tap";
            label = "MT_exit_AML_ON_TAP";
            bindings = <&kp>, <&kp_exit_AML>;

            #binding-cells = <2>;
            tapping-term-ms = <200>;
            flavor = "balanced";
            quick-tap-ms = <200>;
        };

        //AutoShift
        auto_shift: auto_shift {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            tapping_term_ms = <180>;
            quick_tap_ms = <200>;
            flavor = "tap-preferred";
            require-prior-idle-ms = <120>;
            bindings = <&kp>, <&kp>;
        };

        //このあたりは検討の余地あり。Excel系には使えないっぽい
        // 拡大縮小用エンコーダー設定
        zoom_encoder: zoom_encoder {
            compatible = "zmk,behavior-sensor-rotate";
            #sensor-binding-cells = <0>;
            bindings = <&zoom_in_wheel>, <&zoom_out_wheel>;
        };

        // マウスホイール+Ctrlで拡大
        zoom_in_wheel: zoom_in_wheel {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LC(MINUS)>;
        };

        // マウスホイール+Ctrlで縮小  
        zoom_out_wheel: zoom_out_wheel {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LC(PLUS)>;
        };

        //移動レイヤートグル
        lt_arrow_tog: lt_arrow_tog {
            compatible = "zmk,behavior-hold-tap";
            label = "LAYER_ARROW_TOG";
            #binding-cells = <2>;
            tapping-term-ms = <200>;
            quick-tap-ms = <0>;
            flavor = "tap-preferred";
            bindings = <&tog>, <&kp>;
        };

        //IME切替
        chg_ime: chg_ime {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            tapping-term-ms = <200>;
            quick-tap-ms = <150>;
            flavor = "tap-preferred";
            bindings = <&kp>, <&kp>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        DEFAULT_LAYER {
            bindings = <
// |  Q  |  W  |  E  |  R  |  T  |                        |  Y  |  U  |  I  |  O  |  P  | 
// |  A  |  S  |  D  |  F  |  G  | 右クリック  |            |  パイプ/ ¥(現在不可)  |  H  |  J (LAYER_FUNCTION)  |  K  |  - (LAYER_SCROLL)  |
// |  Z (左シフト)  |  X  |  C  |  V  |  B  |  左クリック  |               |  チルダ/  
// |

&kp Q      &kp W         &kp E         &kp R                  &kp T                                                                     &kp Y                  &kp U                 &kp I      &kp O    &kp P
&kp A             &kp S         &kp D         &kp F                  &kp G                &none                          ASSYM(S_PIPE, JP_YEN_MAC)     &kp H                  &lt_arrow_tog LAYER_ARROW_MAC J  &kp K      &kp L    &lt LAYER_SCROLL MINUS
&mt LEFT_SHIFT Z  &kp X         &kp C         &kp V                  &kp B                &kp LA(LG(V))                  &chg_ime LANG1 LANG2          &kp N                  &kp M                ASSYM(S_LESS_THAN,JP_COMMA)  ASSYM(S_GREATER_THAN,JP_DOT)  &kp RIGHT_SHIFT
&kp LCTRL         &kp LEFT_ALT  &kp LEFT_GUI  &lt LAYER_ARROW_MAC ESCAPE     &lt LAYER_NUM SPACE   &lt LAYER_FUNCTION LG(LS(N5))  &mt RIGHT_COMMAND TAB &lt LAYER_ARROW_MAC ENTER    &kp JP_AT 
            >;

            //sensor-bindings = <&ROTATE SCRL_DOWN SCRL_UP>;
            sensor-bindings = <&scroll_encoder>;  // スクロール用のセンサーバインディング
        };

        DEFAULT_LAYER_MAC_NOTE {
            bindings = <
&kp Q      &kp W         &kp E         &kp R                  &kp T                                                                     &kp Y                  &kp U                 &kp I      &kp O    &kp P
&kp A             &kp S         &kp D         &kp F                  &kp G                &none                         ASSYM(S_PIPE, JP_YEN_MAC)     &kp H                  &lt LAYER_FUNCTION J  &kp K      &kp L    &lt LAYER_SCROLL MINUS
&mt LEFT_SHIFT Z  &kp X         &kp C         &kp V                  &kp B                &kp ESCAPE                         ASSYM(S_BQ, JP_AT)           &kp N                  &kp M                ASSYM(S_LESS_THAN,JP_COMMA)  ASSYM(S_GREATER_THAN,JP_DOT)  &kp RIGHT_SHIFT
&kp LCTRL         &kp LEFT_ALT  &kp LEFT_GUI  &lt LAYER_ARROW_MAC ESCAPE     &lt LAYER_NUM SPACE &lt LAYER_FUNCTION &Mac_screenshot &mt RIGHT_COMMAND TAB &lt LAYER_ARROW_MAC ENTER &kp JP_AT
            >;

            sensor-bindings = <&scroll_encoder>;
        };

        DEFAULT_LAYER_IPAD {
            bindings = <
&kp Q      &kp W         &kp E         &kp R                  &kp T                                                                     &kp Y                  &kp U                 &kp I      &kp O    &kp P
&kp A             &kp S         &kp D         &kp F                  &kp G                &none                         ASSYM(S_PIPE, JP_YEN_MAC)     &kp H                  &lt LAYER_FUNCTION J  &kp K      &kp L    &lt LAYER_SCROLL MINUS
&mt LEFT_SHIFT Z  &kp X         &kp C         &kp V                  &kp B                &kp ESCAPE                         ASSYM(S_BQ, JP_AT)           &kp N                  &kp M                ASSYM(S_LESS_THAN,JP_COMMA)  ASSYM(S_GREATER_THAN,JP_DOT)  &kp RIGHT_SHIFT
&kp LCTRL         &kp LEFT_ALT  &kp LEFT_GUI  &lt LAYER_ARROW_MAC ESCAPE     &lt LAYER_NUM SPACE &lt LAYER_FUNCTION &Mac_screenshot &mt RIGHT_COMMAND TAB &lt LAYER_ARROW_MAC ENTER &kp JP_AT
            >;

            //sensor-bindings = <&ROTATE SCRL_DOWN SCRL_UP>;
            sensor-bindings = <&scroll_encoder>;  // スクロール用のセンサーバインディング
        };

        DEFAULT_LAYER_WIN_DESKTOP {
            bindings = <
&kp Q      &kp W         &kp E         &kp R                  &kp T                                                                     &kp Y                  &kp U                 &kp I      &kp O    &kp P
&kp A             &kp S         &kp D         &kp F  &kp G                &none                          ASSYM(S_PIPE, JP_YEN_MAC)     &kp H                  &lt_arrow_tog LAYER_ARROW_WIN J  &kp K      &kp L    &lt LAYER_SCROLL MINUS
&mt LEFT_SHIFT Z  &kp X         &kp C         &kp V  &kp B                &kp ESCAPE                     &chg_ime LANG1 LANG2         &kp N                  &kp M                ASSYM(S_LESS_THAN,JP_COMMA)  ASSYM(S_GREATER_THAN,JP_DOT)  &kp RIGHT_SHIFT
&kp LCTRL         &kp LEFT_ALT  &kp LEFT_GUI         &lt LAYER_ARROW_WIN ESCAPE     &lt LAYER_NUM SPACE &lt LAYER_FUNCTION LG(LS(S)) &mt RCTRL TAB &lt LAYER_ARROW_WIN ENTER      &kp JP_AT

            >;  

            //sensor-bindings = <&ROTATE SCRL_DOWN SCRL_UP>;
            sensor-bindings = <&scroll_encoder>;  // スクロール用のセンサーバインディング
        };

        DEFAULT_LAYER_WIN_COMPANY {
            bindings = <
&kp Q      &kp W         &kp E         &kp R                  &kp T                                                                     &kp Y                  &kp U                 &kp I      &kp O    &kp P
&kp A             &kp S         &kp D         &kp F                  &kp G                &none                         ASSYM(S_PIPE, JP_YEN_MAC)     &kp H                  &kp J  &kp K      &kp L    &lt LAYER_SCROLL MINUS
&mt LEFT_SHIFT Z  &kp X         &kp C         &kp V                  &kp B                &kp LANG2                     &kp LANG1           &kp N                  &kp M                ASSYM(S_LESS_THAN,JP_COMMA)  ASSYM(S_GREATER_THAN,JP_DOT)  &kp RIGHT_SHIFT
&kp LCTRL         &kp LEFT_ALT  &kp LEFT_GUI  &lt LAYER_ARROW_WIN ESCAPE     &lt LAYER_NUM SPACE &lt LAYER_FUNCTION &Win_screenshot &mt RCTRL TAB &lt LAYER_ARROW_WIN ENTER &kp JP_AT
            >;

            //sensor-bindings = <&ROTATE SCRL_DOWN SCRL_UP>;
            sensor-bindings = <&scroll_encoder>;  // スクロール用のセンサーバインディング
        };


        LAYER_ARROW_MAC {
            bindings = <
&kp ESCAPE        &none  &none  &none          &none                                                                    &none       &kp HOME          &none         &kp END           &none
&kp TAB           &kp LA(LG(UP_ARROW))   &kp LC(LEFT_ARROW)      &kp LC(RIGHT_ARROW)      &none  &none      &none       &kp LEFT    &kp DOWN_ARROW    &kp UP_ARROW  &kp RIGHT_ARROW   &kp LG(JP_LBKT)
&kp LEFT_SHIFT    &kp LA(LG(DOWN_ARROW)) &kp LA(LG(LEFT_ARROW))  &kp LA(LG(RIGHT_ARROW))  &none  &none      &none       &kp DELETE  &none             &none         &none             &kp LG(JP_RBKT)
&kp LEFT_CONTROL  &kp LEFT_ALT  &kp LEFT_GUI  &kp LG(Z)           &kp LG(Y)           &none                             &none      &lt_arrow_tog LAYER_ARROW_MAC BACKSPACE                                   &none
            >;

            sensor-bindings = <&scroll_encoder>;  // スクロール用のセンサーバインディング
        };

        LAYER_ARROW_WIN {
            bindings = <
&kp ESCAPE        &none         &none                      &none                 &none                                 &none       &kp HOME        &none         &kp END          &none
&kp TAB           &none         &kp LC(LEFT_ARROW)         &kp LC(RIGHT_ARROW)   &kp F12         &none      &none      &kp LEFT    &kp DOWN_ARROW  &kp UP_ARROW  &kp RIGHT_ARROW  &kp LA(LEFT)
&kp LEFT_SHIFT    &kp X         &kp C                      &kp V                 &kp LC(MINUS)   &none      &none      &kp DELETE  &none           &none         &none            &kp LA(RIGHT)
&kp LEFT_CONTROL  &kp LEFT_ALT  &kp LEFT_GUI               &kp LG(Z)             &kp Y           &none                 &none       &lt_arrow_tog LAYER_ARROW_WIN BACKSPACE        &none
            >;
            sensor-bindings = <&scroll_encoder>;  // スクロール用のセンサーバインディング
        };

        LAYER_NUM {
            bindings = <
&kp S_EXCL  &kp S_DQUO  &kp HASH     &kp S_DLR    &kp S_PERC                     &kp S_AMPR       &kp S_QUOT     &kp S_LPRN   &kp S_RPRN       &kp JP_MINS
&kp JP_1    &kp JP_2    &kp JP_3     &kp JP_4     &kp JP_5     &none      &none  &kp JP_6         &kp JP_7       &kp JP_8     &kp JP_9         &kp JP_0
&trans        &none      &none        &none        &none        &kp LANG2      &kp LANG1  &kp JP_EQL      &kp S_ASTR     &kp S_PLUS   ASSYM(S_QUESTION, JP_SLASH)     ASSYM(S_UNDS, JP_BSLS)
&trans        &trans      &trans        &kp ENTER            &none     &none            &mt RCTRL TAB      &kp ENTER        &none
            >;
        };

        LAYER_FUNCTION {
            bindings = <
&kp F1                  &kp F2                 &kp F3                  &kp F4                   &kp F5                    &kp F6  &kp F7                &kp F8                 &kp F9         &kp F10
&none                   &none   &none      &none      &none   &none      &kp LC(JP_MINS)  &none   ASSYM(S_LCBR, JP_LBKT)  ASSYM(S_RCBR, JP_RBKT)  ASSYM(S_PLUS, JP_SEMI)  &kp F11
&kp LEFT_SHIFT          &none   &none      &none  &none   &none      &none  &none   &none  &none  ASSYM(S_ASTR, JP_COLN)  &kp F12
&kp LEFT_CONTROL        &trans  &trans     &none  &none   &none                               &kp RCTRL  &none                                                        ASSYM(S_TILDE, JP_CIRC)
            >;

            sensor-bindings = <&scroll_encoder>;
        };

        LAYER_SYMBOL {
            bindings = <
&none  &none  &none  &none  &none                                          &none       &none   ASSYM(S_EQL, JP_MINS)    ASSYM(S_TILDE, JP_CIRC)   ASSYM(S_PIPE, JP_YEN_MAC)
&none  &none  &none  &none  &none  &none                        &none      &none       &none   &none                    ASSYM(S_BQ, JP_AT)        ASSYM(S_LCBR, JP_LBKT)
&kp LEFT_SHIFT  &none  &none  &none  &none  &kp LANG2           &kp LANG1      &none       &none   ASSYM(S_PLUS, JP_SEMI)   ASSYM(S_ASTR, JP_COLN)    ASSYM(S_RCBR, JP_RBKT)
&kp LEFT_CONTROL     &kp LEFT_ALT  &kp LEFT_GUI  &none  &none  &none       &kp RCTRL   &none                          &none
            >;
        };

LAYER_10  {
            bindings = <
