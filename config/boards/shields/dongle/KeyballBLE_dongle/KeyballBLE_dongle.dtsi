// KeyballBLE_dongle.dtsi - 最小構成版
// ドングル用の基本定義のみ（Physical Layouts除外）

#include <dt-bindings/zmk/matrix_transform.h>

/ {
    // Matrix Transform定義（キーマップサイズ決定用）
    default_transform: keymap_transform_0 {
        compatible = "zmk,matrix-transform";
        columns = <11>;
        rows = <4>;               
        map = <
            RC(0,0) RC(0,1) RC(0,2) RC(0,3) RC(0,4)                     RC(0,6) RC(0,7) RC(0,8) RC(0,9) RC(0,10)
            RC(1,0) RC(1,1) RC(1,2) RC(1,3) RC(1,4) RC(1,5)     RC(3,6) RC(1,6) RC(1,7) RC(1,8) RC(1,9) RC(1,10)
            RC(2,0) RC(2,1) RC(2,2) RC(2,3) RC(2,4) RC(2,5)     RC(3,7) RC(2,6) RC(2,7) RC(2,8) RC(2,9) RC(2,10)
            RC(3,0) RC(3,1) RC(3,2) RC(3,3) RC(3,4) RC(3,5)     RC(3,8) RC(3,9)                         RC(3,10)         
        >;
    };
    
    // Mock KScan定義（ドングルは物理キーなし）
    mock_kscan: kscan0 {
        compatible = "zmk,kscan-mock";
        columns = <11>;
        rows = <4>;
        events = <0>;
    };

    // ★★★ 追加：Split Pointing Device用の設定 ★★★
    split_inputs {
        compatible = "zmk,split-inputs";
        #address-cells = <1>;
        #size-cells = <0>;

        // 右側トラックボール用のinput-split定義
        trackball_split: trackball_split@0 {
            compatible = "zmk,input-split";
            reg = <0>;
            // device は Peripheral側のoverlayで設定
        };
    };

    // ★★★ 追加：Central側用のinput-listener（デフォルトで無効） ★★★
    trackball_listener: trackball_listener {
        compatible = "zmk,input-listener";
        device = <&trackball_split>;
        status = "disabled";  // デフォルトで無効、overlay側で有効化
    };

    // ダミーエンコーダー定義（ドングルには物理エンコーダーなし,またビルドのためにも必要）
    left_encoder: encoder_left {
        compatible = "alps,ec11";
        // ★安全なダミーピン使用（ドングルでは物理接続なし
        a-gpios = <&gpio0 6 (GPIO_ACTIVE_HIGH | GPIO_PULL_UP)>;
        b-gpios = <&gpio0 7 (GPIO_ACTIVE_HIGH | GPIO_PULL_UP)>;
        steps = <24>;
        status = "disabled";  // 常に無効
    };
        
    // sensors定義をドングル用dtsiに追加
    sensors: sensors {
        compatible = "zmk,keymap-sensors";
        sensors = <&left_encoder>;  // ドングルでは左側のみ
        triggers-per-rotation = <16>;  // 1回転で10回反応
        status = "okay";  // デフォルト無効
    };

};

